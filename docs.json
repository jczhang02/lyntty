{
  "$schema": "https://tangly.dev/schema/docs.json",
  "name": "Lyntty Docs",
  "description": "Product, architecture, agent, and recovery documentation for Lyntty.",
  "theme": "readable",
  "colors": {
    "primary": "#2563eb"
  },
  "siteUrl": "https://jczhang02.github.io",
  "navigation": {
    "tabs": [
      {
        "tab": "English",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "docs/README",
              "CONTEXT-MAP"
            ]
          },
          {
            "group": "Product",
            "pages": [
              "docs/prds/lyntty-product",
              "docs/recovered/previous-lyntty-decisions"
            ]
          },
          {
            "group": "Domain",
            "pages": [
              "docs/contexts/product/CONTEXT"
            ]
          }
        ]
      },
      {
        "tab": "中文",
        "groups": [
          {
            "group": "产品",
            "pages": [
              "docs/prds/zh/lyntty-product",
              "docs/recovered/zh/previous-lyntty-decisions"
            ]
          },
          {
            "group": "领域",
            "pages": [
              "docs/contexts/product/zh/CONTEXT"
            ]
          }
        ]
      },
      {
        "tab": "Agents",
        "groups": [
          {
            "group": "Skill configuration",
            "pages": [
              "docs/agents/issue-tracker",
              "docs/agents/triage-labels",
              "docs/agents/domain"
            ]
          },
          {
            "group": "技能配置（中文）",
            "pages": [
              "docs/agents/zh/issue-tracker",
              "docs/agents/zh/triage-labels",
              "docs/agents/zh/domain"
            ]
          },
          {
            "group": "Editing rules",
            "pages": [
              "AGENTS",
              "docs/AGENTS"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/jczhang02/lyntty",
          "icon": "github"
        }
      ]
    }
  },
  "search": {
    "prompt": "Search Lyntty docs..."
  },
  "appearance": {
    "default": "system",
    "readingTime": true,
    "readingProgress": true
  },
  "footer": {
    "lastUpdated": false
  }
}
