{
    "name": "lyntty-cli",
    "version": "1.2.0",
    "private": true,
    "description": "Mobile control for local pi sessions",
    "author": "JC Zhang",
    "license": "MIT",
    "type": "module",
    "homepage": "https://github.com/jczhang02/lyntty",
    "bugs": "https://github.com/jczhang02/lyntty/issues",
    "repository": {
        "type": "git",
        "url": "https://github.com/jczhang02/lyntty"
    },
    "bin": {
        "lyntty": "./bin/lyntty.mjs"
    },
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./lib": {
            "require": {
                "types": "./dist/lib.d.cts",
                "default": "./dist/lib.cjs"
            },
            "import": {
                "types": "./dist/lib.d.mts",
                "default": "./dist/lib.mjs"
            }
        }
    },
    "files": [
        "dist",
        "bin",
        "tools/archives",
        "tools/licenses",
        "install",
        "package.json"
    ],
    "scripts": {
        "typecheck": "bunx tsc --noEmit",
        "build": "rm -rf dist && bunx tsc --noEmit && bunx pkgroll",
        "build:compiled": "rm -rf dist/compiled && mkdir -p dist/compiled && bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --no-compile-autoload-package-json ./src/index.ts --outfile dist/compiled/lyntty && bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --no-compile-autoload-package-json ./src/daemon/entry.ts --outfile dist/compiled/lynttyd",
        "build:artifact": "bun ./scripts/build-artifact.ts",
        "build:artifacts": "bun ./scripts/build-artifact.ts --all",
        "test": "bun test --isolate --preload ./src/test-setup.ts src",
        "test:integration": "bun run build:compiled && bun run --cwd ../lyntty-relay build:standalone && bun ./scripts/compiled-daemon-integration.ts"
    },
    "dependencies": {
        "@earendil-works/pi-coding-agent": "0.80.2",
        "@paralleldrive/cuid2": "^2.2.2",
        "@stablelib/hex": "^2.0.1",
        "axios": "^1.18.1",
        "chalk": "^5.6.2",
        "cross-spawn": "^7.0.6",
        "expo-server-sdk": "^3.15.0",
        "fastify": "^5.10.0",
        "fastify-type-provider-zod": "^6.1.0",
        "lyntty-wire": "workspace:*",
        "ps-list": "^8.1.1",
        "qrcode-terminal": "^0.12.0",
        "semver": "^7.7.2",
        "socket.io-client": "^4.8.1",
        "tmp": "^0.2.7",
        "tweetnacl": "^1.0.3",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@types/node": ">=20",
        "pkgroll": "^2.14.2",
        "typescript": "5.9.3",
        "@types/bun": "1.3.14",
        "@types/cross-spawn": "^6.0.6",
        "@types/qrcode-terminal": "^0.12.2",
        "@types/semver": "^7.7.0",
        "@types/tmp": "^0.2.6"
    }
}
