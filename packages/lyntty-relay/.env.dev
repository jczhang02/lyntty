# Source-development defaults. Never copy these values into production.
DB_PROVIDER=pglite
LYNTTY_MASTER_SECRET=local-development-secret-change-me
PORT=3005
NODE_ENV=development

# Operator metrics and optional local file logging.
METRICS_ENABLED=true
METRICS_PORT=9090
# LYNTTY_FILE_LOGGING=1

# External PostgreSQL (run migrations explicitly before serve).
# DB_PROVIDER=postgres
# DATABASE_URL=postgresql://lyntty:lyntty@localhost:5432/lyntty

# Redis Socket.IO adapter for multi-process deployments.
# REDIS_URL=redis://localhost:6379

# S3-compatible encrypted attachment storage.
# S3_HOST=localhost
# S3_PORT=9000
# S3_USE_SSL=false
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=lyntty
