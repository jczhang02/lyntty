{
    "name": "lyntty-relay",
    "version": "1.1.11",
    "private": true,
    "description": "Self-hosted Lyntty Relay API",
    "repository": {
        "type": "git",
        "url": "https://github.com/jczhang02/lyntty"
    },
    "homepage": "https://github.com/jczhang02/lyntty",
    "bugs": "https://github.com/jczhang02/lyntty/issues",
    "author": "Kirill Dubovitskiy",
    "license": "MIT",
    "type": "module",
    "bin": {
        "lyntty-relay": "./bin/lyntty-relay.cjs"
    },
    "main": "./index.cjs",
    "exports": {
        ".": "./index.cjs",
        "./standalone": "./dist/standalone.mjs",
        "./package.json": "./package.json"
    },
    "files": [
        "bin",
        "index.cjs",
        "dist",
        "prisma",
        "package.json",
        "README.md"
    ],
    "scripts": {
        "typecheck": "bunx tsc --noEmit",
        "build": "bun run typecheck && bun scripts/build-runtime.cjs",
        "build:runtime": "bun scripts/build-runtime.cjs",
        "build:standalone": "rm -rf dist && mkdir -p dist/prisma && bun build ./sources/standalone.ts --compile --outfile dist/lyntty-relay --target bun && cp node_modules/@electric-sql/pglite/dist/{pglite.wasm,pglite.data} dist/ && cp -r prisma/migrations dist/prisma/migrations",
        "start": "bun ./sources/main.ts",
        "standalone": "bun ./sources/standalone.ts",
        "standalone:dev": "bun --env-file=.env.dev ./sources/standalone.ts migrate && bun --env-file=.env.dev ./sources/standalone.ts serve",
        "dev": "lsof -ti tcp:3005 | xargs kill -9 || true; bun --env-file=.env --env-file=.env.dev ./sources/main.ts",
        "test": "bunx vitest run",
        "migrate": "bun --env-file=.env.dev run prisma migrate dev",
        "migrate:reset": "bun --env-file=.env.dev run prisma migrate reset",
        "generate": "bun run prisma generate --schema=prisma/schema.prisma",
        "postinstall": "bun run prisma generate --schema=prisma/schema.prisma"
    },
    "devDependencies": {
        "@types/chalk": "^2.2.0",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.12.3",
        "@types/pg": "^8.15.5",
        "@types/semver": "^7.7.0",
        "@types/tmp": "^0.2.6",
        "@types/uuid": "^9.0.8",
        "prisma": "7.8.0",
        "prisma-json-types-generator": "5.1.1",
        "typescript": "5.9.3",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.0",
        "yaml": "^2.4.2"
    },
    "dependencies": {
        "@date-fns/tz": "^1.2.0",
        "@electric-sql/pglite": "0.3.15",
        "@fastify/bearer-auth": "^10.1.1",
        "@fastify/cors": "^10.0.1",
        "@fastify/static": "^8.1.1",
        "@octokit/webhooks": "14.2.0",
        "@prisma/adapter-pg": "7.8.0",
        "@prisma/client": "7.8.0",
        "@socket.io/redis-streams-adapter": "^0.2.2",
        "axios": "^1.18.1",
        "chalk": "4.1.2",
        "date-fns": "^4.1.0",
        "dotenv": "^16.4.5",
        "elevenlabs": "^1.54.0",
        "fastify": "^5.10.0",
        "fastify-type-provider-zod": "^6.1.0",
        "ioredis": "^5.6.1",
        "jsonwebtoken": "^9.0.2",
        "lyntty-wire": "workspace:*",
        "minio": "^8.0.7",
        "octokit": "^5.0.3",
        "pg": "8.22.0",
        "pglite-prisma-adapter": "0.7.2",
        "pino": "^10.3.0",
        "pino-pretty": "^13.0.0",
        "privacy-kit": "^0.0.25",
        "prom-client": "^15.1.3",
        "redis": "5.11.0",
        "reflect-metadata": "^0.2.2",
        "semver": "^7.7.2",
        "sharp": "^0.34.3",
        "socket.io": "^4.8.1",
        "socket.io-adapter": "^2.5.5",
        "tmp": "^0.2.3",
        "tweetnacl": "^1.0.3",
        "uuid": "^9.0.1",
        "zod": "^4.0.0",
        "zod-to-json-schema": "^3.24.3"
    }
}
