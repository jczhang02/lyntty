{
    "name": "lyntty-relay",
    "version": "1.2.1",
    "private": true,
    "description": "Self-hosted Lyntty Relay API",
    "repository": {
        "type": "git",
        "url": "https://github.com/jczhang02/lyntty"
    },
    "homepage": "https://github.com/jczhang02/lyntty",
    "bugs": "https://github.com/jczhang02/lyntty/issues",
    "author": "Kirill Dubovitskiy",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "typecheck": "bunx tsc --noEmit",
        "build": "bun run build:standalone",
        "build:standalone": "rm -rf dist && mkdir -p dist/prisma && bun build ./sources/standalone.ts --compile --outfile dist/lyntty-relay --target bun && cp node_modules/@electric-sql/pglite/dist/{pglite.wasm,pglite.data} dist/ && cp -r prisma/migrations dist/prisma/migrations",
        "start": "bun ./sources/main.ts",
        "standalone": "bun ./sources/standalone.ts",
        "standalone:dev": "bun --env-file=.env.dev ./sources/standalone.ts migrate && bun --env-file=.env.dev ./sources/standalone.ts serve",
        "dev": "lsof -ti tcp:3005 | xargs kill -9 || true; bun --env-file=.env --env-file=.env.dev ./sources/main.ts",
        "test": "bun test --isolate sources",
        "test:compiled": "bash ./scripts/compiled-smoke.sh",
        "test:container": "bash ./scripts/container-smoke.sh",
        "test:postgres": "bun run build:standalone && bash ./scripts/postgres-integration.sh",
        "migrate": "bun --env-file=.env.dev run prisma migrate dev",
        "migrate:reset": "bun --env-file=.env.dev run prisma migrate reset",
        "generate": "bun run prisma generate --schema=prisma/schema.prisma",
        "postinstall": "bun run prisma generate --schema=prisma/schema.prisma"
    },
    "devDependencies": {
        "@types/bun": "1.3.14",
        "@types/node": "^20.12.3",
        "@types/pg": "^8.15.5",
        "@types/semver": "^7.7.0",
        "prisma": "7.8.0",
        "prisma-json-types-generator": "5.1.1",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "@electric-sql/pglite": "0.3.15",
        "@fastify/cors": "^10.0.1",
        "@prisma/adapter-pg": "7.8.0",
        "@prisma/client": "7.8.0",
        "@socket.io/redis-streams-adapter": "^0.2.2",
        "fastify": "^5.10.0",
        "fastify-type-provider-zod": "^6.1.0",
        "ioredis": "^5.6.1",
        "lyntty-wire": "workspace:*",
        "minio": "^8.0.7",
        "pg": "8.22.0",
        "pglite-prisma-adapter": "0.7.2",
        "pino": "^10.3.0",
        "pino-pretty": "^13.0.0",
        "privacy-kit": "^0.0.25",
        "prom-client": "^15.1.3",
        "redis": "4.7.1",
        "reflect-metadata": "^0.2.2",
        "semver": "^7.7.2",
        "socket.io": "^4.8.1",
        "tweetnacl": "^1.0.3",
        "zod": "^4.0.0"
    }
}
