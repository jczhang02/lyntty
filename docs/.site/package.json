{
  "name": "lyntty-docs",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "docs:prepare": "bun scripts/prepare-fumadocs-pages.mjs",
    "docs:check": "bun run docs:prepare && bunx fumadocs-mdx source.config.ts && bunx tsc --noEmit",
    "docs:build": "bun run docs:prepare && bunx next build && bun scripts/write-fumadocs-agent-files.mjs && bun scripts/validate-static-output.mjs",
    "docs:preview": "bunx serve out"
  },
  "devDependencies": {
    "@fontsource/lora": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "2.0.14",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "fumadocs-core": "16.10.5",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-ui": "16.10.5",
    "next": "16.2.9",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "serve": "14.2.5",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
