{
  "name": "lyntty-docs",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "docs:prepare": "bun scripts/prepare-fumadocs-pages.mjs",
    "docs:audit": "bun audit",
    "docs:check": "bun run docs:prepare && bunx fumadocs-mdx source.config.ts && bunx tsc --noEmit",
    "docs:build": "bun run docs:prepare && bunx next build && bun scripts/write-fumadocs-agent-files.mjs && bun scripts/validate-static-output.mjs",
    "docs:preview": "bunx serve out"
  },
  "devDependencies": {
    "@fontsource/lora": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "25.0.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "fumadocs-core": "16.13.0",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.13.0",
    "next": "16.2.12",
    "postcss": "^8.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "ajv": "8.18.0",
    "brace-expansion": "5.0.8",
    "minimatch": "3.1.5",
    "postcss": "8.5.19",
    "sharp": "0.35.3"
  },
  "patchedDependencies": {
    "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
  }
}
