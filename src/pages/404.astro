---
const homeUrl = `${import.meta.env.BASE_URL}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | Lyntty Docs</title>
    <style>
      :root {
        background: #faf9f5;
        color: #141413;
        color-scheme: light;
        font-family: Lora, Georgia, "Times New Roman", serif;
      }

      body {
        align-items: center;
        display: grid;
        margin: 0;
        min-height: 100vh;
        padding: 2rem;
      }

      main {
        background: #f4f1e8;
        border: 1px solid #e8e6dc;
        border-radius: 1.25rem;
        margin: 0 auto;
        max-width: 36rem;
        padding: 2rem;
      }

      h1 {
        color: #141413;
        font-family: Poppins, Arial, Helvetica, sans-serif;
        font-size: clamp(2.5rem, 8vw, 5rem);
        letter-spacing: -0.05em;
        line-height: 1;
        margin: 0 0 1rem;
      }

      a {
        color: #8f3f28;
        text-decoration-color: #d97757;
        text-underline-offset: 0.18em;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>404</h1>
      <p>The requested Lyntty docs page does not exist.</p>
      <p><a href={homeUrl}>Back to docs home</a></p>
    </main>
  </body>
</html>
