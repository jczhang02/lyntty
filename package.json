{
  "name": "lyntty-monorepo",
  "private": true,
  "scripts": {
    "cli": "bun packages/lyntty-cli/src/index.ts",
    "postinstall": "bun ./scripts/postinstall.cjs",
    "ci:wire": "bun run --filter lyntty-wire build && bun run --filter lyntty-wire test",
    "ci:cli": "bun run --filter lyntty-cli typecheck && bun run --filter lyntty-cli build && bun run --filter lyntty-cli test",
    "ci:daemon-integration": "bun run --cwd packages/lyntty-cli test:integration",
    "ci:relay": "bun run --filter lyntty-relay typecheck && bun run --filter lyntty-relay build && bun run --filter lyntty-relay test:compiled && bun run --filter lyntty-relay test",
    "ci:app": "bun run --filter lyntty-app typecheck && bun run --filter lyntty-app lint:i18n && bun run --filter lyntty-app test && cd packages/lyntty-app && bunx expo config --type introspect --json > /tmp/lyntty-expo-config.json",
    "ci:audit": "bun audit",
    "ci:fast": "bun run test:repo-hardening && bun run ci:audit && bun run ci:wire && bun run ci:cli && bun run ci:relay && bun run ci:app && git diff --check",
    "test:repo-hardening": "bun test scripts/workflow-hardening.test.mjs scripts/evidence-redaction.test.mjs",
    "release:bom": "bun ./scripts/release.ts",
    "mobile": "bun run --filter lyntty-app start",
    "android": "bun run --filter lyntty-app android",
    "e2e:maestro": "scripts/e2e/run-maestro.sh e2e/maestro",
    "e2e:maestro:first-run": "scripts/e2e/run-maestro.sh e2e/maestro/01_first_run.yml",
    "e2e:maestro:pair": "scripts/e2e/run-maestro.sh e2e/maestro/02_pair_node.yml",
    "e2e:maestro:history": "scripts/e2e/run-maestro.sh e2e/maestro/03_history_send_reply.yml",
    "e2e:maestro:reconnect": "scripts/e2e/run-maestro.sh e2e/maestro/04_reconnect_smoke.yml"
  },
  "workspaces": [
    "packages/lyntty-app",
    "packages/lyntty-cli",
    "packages/lyntty-relay",
    "packages/lyntty-wire"
  ],
  "devDependencies": {
    "lyntty-wire": "workspace:*"
  },
  "overrides": {
    "whatwg-url": "14.2.0",
    "parse-path": "7.0.3",
    "@types/parse-path": "7.0.3",
    "@hono/node-server": "1.19.13",
    "defu": "6.1.5",
    "@prisma/config>effect": "3.20.0",
    "@electric-sql/pglite": "0.3.15",
    "fast-uri": "3.1.2",
    "form-data": "4.0.6",
    "hono": "4.12.25",
    "lodash-es": "4.18.0",
    "node-forge": "1.4.0",
    "path-to-regexp": "8.4.0",
    "prismjs": "1.30.0",
    "shell-quote": "1.8.4",
    "socket.io-parser": "4.2.6",
    "react-devtools-core>ws": "7.5.11",
    "engine.io>ws": "8.21.0",
    "engine.io-client>ws": "8.21.0",
    "uuid": "11.1.1"
  },
  "trustedDependencies": [
    "@more-tech/react-native-libsodium",
    "@prisma/client",
    "@prisma/engines",
    "@shopify/react-native-skia",
    "@tailwindcss/oxide",
    "esbuild",
    "lyntty-relay",
    "prisma",
    "protobufjs",
    "sharp"
  ],
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "expo-modules-autolinking@55.0.24": "patches/expo-modules-autolinking@55.0.24.patch",
    "expo-modules-core@55.0.25": "patches/expo-modules-core@55.0.25.patch",
    "expo-constants@55.0.16": "patches/expo-constants@55.0.16.patch",
    "react-native-reanimated@4.5.1": "patches/react-native-reanimated@4.5.1.patch",
    "react-native-worklets@0.10.2": "patches/react-native-worklets@0.10.2.patch",
    "@react-native/gradle-plugin@0.83.1": "patches/@react-native%2Fgradle-plugin@0.83.1.patch",
    "@shopify/react-native-skia@2.5.5": "patches/@shopify%2Freact-native-skia@2.5.5.patch"
  }
}
