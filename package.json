{
    "name": "lyntty-monorepo",
    "private": true,
    "scripts": {
        "cli": "pnpm --filter lyntty-cli cli",
        "release": "node ./scripts/release.cjs",
        "postinstall": "node ./scripts/postinstall.cjs",
        "env:new": "tsx environments/environments.ts new",
        "env:list": "tsx environments/environments.ts list",
        "env:use": "tsx environments/environments.ts use",
        "env:remove": "tsx environments/environments.ts remove",
        "env:current": "tsx environments/environments.ts current",
        "env:server": "tsx environments/environments.ts run server",
        "env:android": "tsx environments/environments.ts run android",
        "env:cli": "tsx environments/environments.ts run cli",
        "env:seed": "tsx environments/environments.ts seed",
        "env:up": "tsx environments/environments.ts up",
        "env:up:authenticated": "pnpm env:up --template authenticated-empty",
        "env:down": "tsx environments/environments.ts down",
        "env:tailscale": "tsx environments/environments.ts tailscale",
        "ci:wire": "pnpm --filter ./packages/lyntty-wire build && pnpm --filter ./packages/lyntty-wire test",
        "ci:cli": "pnpm --filter ./packages/lyntty-cli typecheck && pnpm --filter ./packages/lyntty-cli test",
        "ci:relay": "pnpm --filter ./packages/lyntty-relay typecheck && pnpm --filter ./packages/lyntty-relay build && pnpm --filter ./packages/lyntty-relay test",
        "ci:app": "pnpm --filter ./packages/lyntty-app typecheck && pnpm --filter ./packages/lyntty-app lint:i18n && pnpm --filter ./packages/lyntty-app test -- --run && pnpm --filter ./packages/lyntty-app exec expo config --type introspect --json > /tmp/lyntty-expo-config.json",
        "ci:agent": "pnpm --filter ./packages/lyntty-agent typecheck && pnpm --filter ./packages/lyntty-agent test",
        "ci:fast": "pnpm ci:wire && pnpm ci:cli && pnpm ci:relay && pnpm ci:app && pnpm ci:agent && git diff --check",
        "mobile": "pnpm --filter lyntty-app start",
        "android": "pnpm --filter lyntty-app android",
        "e2e:maestro": "scripts/e2e/run-maestro.sh e2e/maestro",
        "e2e:maestro:first-run": "scripts/e2e/run-maestro.sh e2e/maestro/01_first_run.yml",
        "e2e:maestro:pair": "scripts/e2e/run-maestro.sh e2e/maestro/02_pair_node.yml",
        "e2e:maestro:history": "scripts/e2e/run-maestro.sh e2e/maestro/03_history_send_reply.yml",
        "e2e:maestro:reconnect": "scripts/e2e/run-maestro.sh e2e/maestro/04_reconnect_smoke.yml",
        "e2e:release-matrix": "scripts/e2e/release-matrix.sh"
    },
    "workspaces": {
        "packages": [
            "packages/lyntty-app",
            "packages/lyntty-agent",
            "packages/lyntty-cli",
            "packages/lyntty-relay",
            "packages/lyntty-wire",
            "packages/lyntty-app-logs",
            "packages/codium"
        ]
    },
    "pnpm": {
        "overrides": {
            "whatwg-url": "14.2.0",
            "parse-path": "7.0.3",
            "@types/parse-path": "7.0.3"
        },
        "onlyBuiltDependencies": [
            "@more-tech/react-native-libsodium",
            "@prisma/client",
            "@prisma/engines",
            "@shopify/react-native-skia",
            "@tailwindcss/oxide",
            "better-sqlite3",
            "electron",
            "esbuild",
            "node-pty",
            "prisma",
            "sharp"
        ]
    },
    "packageManager": "pnpm@10.11.0"
}
